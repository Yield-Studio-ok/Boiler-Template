{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "**/node_modules/**",
    "pnpm-lock.yaml"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "unicorn", "oxc"],
  "env": {
    "node": true
  },
  "rules": {
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }]
  },
  "settings": {
    "next": {
      "rootDir": "apps/web"
    }
  },
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "unicorn/require-module-specifiers": "off"
      }
    },
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y"],
      "env": {
        "browser": true
      }
    }
  ]
}
