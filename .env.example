# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=boilerplate

# ── Puertos (el Hub los asigna automaticamente) ──
PUERTO_BACKEND=3001
PUERTO_FRONTEND=3000
# Solo se publica en docker-compose.yml (dev). En prod Postgres no sale al host.
PUERTO_POSTGRES=5432

# ── NestJS ──
# Firma los JWT del login demo (dev). En producción igual tiene que estar seteado.
JWT_SECRET=cambiar-por-secret-seguro
# En producción: URL del frontend. Varias origins separadas por coma.
CORS_ORIGIN=http://localhost:${PUERTO_FRONTEND}

# ── Next.js ──
NEXT_PUBLIC_API_URL=http://localhost:${PUERTO_BACKEND}

# ── Firebase Admin (producción, obligatorio) ──
# Montar el JSON de service account como volumen en docker-compose.prod.yml.
# Si el archivo falta o es inválido, la API no arranca (no hay fallback a demo).
